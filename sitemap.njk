---
permalink: sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absoluteUrl(site.url) }}</loc></url>
  <url><loc>{{ '/blog/' | absoluteUrl(site.url) }}</loc></url>
  {% for post in blog.posts %}<url><loc>{{ post.url | absoluteUrl(site.url) }}</loc><lastmod>{{ post.date | dateToRfc3339 }}</lastmod></url>{% endfor %}
  {% for tag in blog.tags %}<url><loc>{{ tag.url | absoluteUrl(site.url) }}</loc></url>{% endfor %}
</urlset>
