#!/bin/sh
set -eu

# Obsidian Git's configured message script creates a one-shot marker before it
# starts git commit. This lets the hook distinguish plugin syncs from ordinary
# developer commits without relying on undocumented process environment.
obsidian_marker=$(git rev-parse --git-path obsidian-git-commit)
guard_passed_marker=$(git rev-parse --git-path obsidian-git-guard-passed)
if [ "${OBSIDIAN_GIT:-}" != "1" ] && [ ! -f "$obsidian_marker" ]; then
  exit 0
fi
rm -f "$obsidian_marker" "$guard_passed_marker"

repo_root=$(git rev-parse --show-toplevel)
python_bin=/usr/bin/python3
if [ ! -x "$python_bin" ]; then
  python_bin=$(command -v python3 || true)
fi
if [ -z "$python_bin" ]; then
  echo "Obsidian Git commit rejected: Python 3 is required by the content guard." >&2
  exit 1
fi

"$python_bin" "$repo_root/.githooks/obsidian_guard.py"
: > "$guard_passed_marker"
