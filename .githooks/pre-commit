#!/bin/sh
set -eu

# Only Obsidian Git is restricted to the publishing allowlist. Normal developer
# commits keep the repository's regular Git behavior.
if [ "${OBSIDIAN_GIT:-}" != "1" ]; then
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
python_bin=/usr/bin/python3
if [ ! -x "$python_bin" ]; then
  python_bin=$(command -v python3 || true)
fi
if [ -z "$python_bin" ]; then
  echo "Obsidian Git commit rejected: Python 3 is required by the content guard." >&2
  exit 1
fi

exec "$python_bin" "$repo_root/.githooks/obsidian_guard.py"
