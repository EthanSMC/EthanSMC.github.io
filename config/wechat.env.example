# The Mac Agent creates a protected copy of this configuration outside the repository.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

WECHAT_REPO_URL=https://github.com/EthanSMC/EthanSMC.github.io.git
WECHAT_SYNC_BRANCH=main
WECHAT_SYNC_REMOTE=origin
WECHAT_POLL_INTERVAL=300

SITE_URL=https://ethansmc-personal-page.vercel.app
WECHAT_AUTHOR=申名翀 Ethan

# The first local article image is the default cover. Set this to force one cover for every article.
# WECHAT_DEFAULT_COVER=assets/share-card-writing.png

# The installer sets this to persistent private storage under ~/Library/Application Support.
# WECHAT_SYNC_STATE_FILE=/absolute/private/path/state.json
